.venv/
__pycache__/
*.pyc
.DS_Store

# Built site — regenerated by the pipeline, deployed straight from the Actions
# runner. Not committed so the repo doesn't churn a large diff every week.
_site/

# Raw fetch payloads. The provenance manifest (data/cache/manifest.json) IS
# committed by the refresh workflow; everything else here is scratch.
data/cache/*
!data/cache/.gitkeep
!data/cache/manifest.json
