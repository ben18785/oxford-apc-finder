.venv/
__pycache__/
*.pyc
.DS_Store

# Local secrets (e.g. OPENALEX_API_KEY) for running the pipeline outside CI.
.env

# Built site — regenerated by the pipeline, deployed straight from the Actions
# runner. Not committed so the repo doesn't churn a large diff every week.
_site/

# Raw fetch payloads. The provenance manifest (data/cache/manifest.json) IS
# committed by the refresh workflow; everything else here is scratch.
data/cache/*
!data/cache/.gitkeep
!data/cache/manifest.json

# Pipeline output is regenerated from scratch every run and is large
# (metadata.json runs to hundreds of MB). Only last_counts.json is committed —
# validate.py reads it back as the week-on-week baseline.
data/out/*
!data/out/.gitkeep
!data/out/last_counts.json

# Fixture-mode changelog artefacts — never the real baseline.
data/state/journal_state.fixtures.tsv
data/state/known_journals.fixtures.tsv
CHANGELOG-data.fixtures.md
data/out-fixtures/
